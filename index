<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ระบบติดตามค่ากีฬาสี NP-404</title>
  <link rel="icon" type="image/png"
        href="https://i.postimg.cc/ZqwL8RKR/Untitled-design.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <!-- Supabase -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <style>
    :root {
      --black:#080808;
      --gray:#666;
      --border:#e5e5e5;
      --danger:#e53935;
      --success:#2e7d32;
      --warning:#f59e0b;
    }
    * {
      margin:0;
      padding:0;
      box-sizing:border-box;
    }
    body {
      font-family:"Prompt",sans-serif;
      background:
        radial-gradient(circle at 10% 5%,#ededed 0,transparent 30%),
        radial-gradient(circle at 90% 95%,#e7e7e7 0,transparent 30%),
        #f5f5f5;
      color:var(--black);
      min-height:100vh;
      padding:12px;
    }
    .container {
      width:100%;
      max-width:768px;
      margin:auto;
    }
    .admin-bar {
      display:none;
      background:#fff;
      border:1px solid var(--border);
      border-radius:16px;
      padding:10px 16px;
      margin-bottom:15px;
      justify-content:space-between;
      align-items:center;
      box-shadow:0 4px 15px rgba(0,0,0,.03);
    }
    .admin-nav-tabs {
      display:flex;
      gap:8px;
    }
    .nav-tab-btn {
      background:#f0f0f0;
      border:none;
      padding:7px 14px;
      border-radius:8px;
      font-family:"Prompt";
      font-size:12px;
      cursor:pointer;
    }
    .nav-tab-btn.active {
      background:#111;
      color:#fff;
    }
    .company-header {
      background:#080808;
      color:white;
      border-radius:20px;
      padding:20px 15px;
      text-align:center;
      box-shadow:0 10px 30px rgba(0,0,0,.12);
      margin-bottom:15px;
    }
    .logo-wrapper {
      width:70px;
      height:70px;
      margin:0 auto 10px;
    }
    .logo-wrapper img {
      width:100%;
      height:100%;
      object-fit:contain;
      border-radius:12px;
    }
    .company-header h1 {
      font-size:18px;
      font-weight:600;
    }
    .company-header p {
      font-size:12px;
      color:#aaa;
    }
    .summary-container {
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
      gap:12px;
      margin-bottom:15px;
    }
    .summary-card {
      background:#fff;
      border-radius:16px;
      padding:14px 16px;
      border:1px solid var(--border);
      box-shadow:0 4px 12px rgba(0,0,0,.03);
    }
    .summary-card h4 {
      font-size:13px;
      margin-bottom:8px;
      border-bottom:1px solid #f0f0f0;
      padding-bottom:4px;
    }
    .summary-row {
      display:flex;
      justify-content:space-between;
      font-size:12px;
      margin-top:4px;
    }
    .text-success {
      color:var(--success);
      font-weight:600;
    }
    .text-danger {
      color:var(--danger);
      font-weight:600;
    }
    .main-card {
      background:rgba(255,255,255,.98);
      border:1px solid rgba(0,0,0,.06);
      border-radius:20px;
      padding:16px;
      box-shadow:0 10px 30px rgba(0,0,0,.05);
    }
    #adminDashboardView {
      display:none;
    }
    .form-group {
      margin-bottom:10px;
    }
    .form-group label {
      display:block;
      font-size:12px;
      font-weight:500;
      margin-bottom:4px;
      color:#444;
    }
    .form-control {
      width:100%;
      padding:10px 12px;
      border:1px solid var(--border);
      border-radius:10px;
      font-family:"Prompt";
      font-size:13px;
      background:#fafafa;
    }
    .form-control:focus {
      outline:none;
      border-color:#111;
      background:#fff;
    }
    .form-row {
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(140px,1fr));
      gap:10px;
    }
    .btn-container {
      display:flex;
      gap:8px;
      margin-top:10px;
      flex-wrap:wrap;
    }
    .action-btn {
      height:40px;
      padding:0 16px;
      border:none;
      border-radius:10px;
      background:#111;
      color:#fff;
      font-family:"Prompt";
      font-size:13px;
      cursor:pointer;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      flex:1;
      min-width:120px;
    }
    .action-btn:hover {
      opacity:.9;
    }
    .btn-secondary {
      background:#666;
    }
    .btn-danger {
      background:var(--danger);
    }
    .student-card {
      background:#fff;
      border:1px solid var(--border);
      border-radius:14px;
      padding:14px;
      margin-bottom:10px;
      box-shadow:0 2px 6px rgba(0,0,0,.02);
    }
    .student-header {
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin-bottom:8px;
      padding-bottom:6px;
      border-bottom:1px dashed var(--border);
      gap:10px;
    }
    .student-name {
      font-weight:600;
      font-size:14px;
      word-break:break-word;
    }
    .student-class {
      font-size:11px;
      color:var(--gray);
      background:#f0f0f0;
      padding:2px 8px;
      border-radius:6px;
      white-space:nowrap;
    }
    .status-group {
      display:flex;
      justify-content:space-between;
      align-items:center;
      font-size:12px;
      margin-bottom:4px;
      gap:10px;
    }
    .badge {
      font-size:11px;
      padding:2px 8px;
      border-radius:12px;
      font-weight:500;
      white-space:nowrap;
    }
    .badge-success {
      background:#e8f5e9;
      color:var(--success);
    }
    .badge-danger {
      background:#ffebee;
      color:var(--danger);
    }
    .admin-form-section {
      border-bottom:1px dashed var(--border);
      padding-bottom:15px;
      margin-bottom:20px;
    }
    .admin-box-title {
      font-size:14px;
      font-weight:600;
      margin-bottom:12px;
    }
    .admin-table-container {
      overflow-x:auto;
      border:1px solid var(--border);
      border-radius:12px;
    }
    .admin-table {
      width:100%;
      border-collapse:collapse;
      font-size:12px;
    }
    .admin-table th,
    .admin-table td {
      padding:10px;
      border-bottom:1px solid var(--border);
      white-space:nowrap;
    }
    .admin-table th {
      background:#f8f8f8;
      font-weight:600;
    }
    .sm-btn {
      padding:6px 12px;
      border-radius:6px;
      border:none;
      font-size:11px;
      font-family:"Prompt";
      cursor:pointer;
    }
    .btn-edit {
      background:#e0e0e0;
      color:#333;
    }
    .btn-delete {
      background:#ffebee;
      color:var(--danger);
    }
    #loading {
      text-align:center;
      color:#888;
      padding:20px;
      font-size:13px;
    }
    .footer {
      text-align:center;
      padding:15px 10px 5px;
      color:#888;
      font-size:11px;
    }
    .admin-login-link {
      background:none;
      border:none;
      color:#aaa;
      font-size:11px;
      font-family:"Prompt";
      cursor:pointer;
      text-decoration:underline;
      margin-top:6px;
    }
    .modal-overlay {
      position:fixed;
      inset:0;
      background:rgba(0,0,0,.5);
      backdrop-filter:blur(4px);
      display:none;
      justify-content:center;
      align-items:center;
      z-index:999;
      padding:15px;
    }
    .modal-box {
      background:#fff;
      width:100%;
      max-width:360px;
      border-radius:16px;
      padding:20px;
      box-shadow:0 10px 30px rgba(0,0,0,.2);
      text-align:center;
    }
    .modal-icon {
      font-size:32px;
      margin-bottom:8px;
    }
    .modal-box h3 {
      font-size:16px;
      margin-bottom:8px;
    }
    .modal-box p {
      font-size:13px;
      color:#666;
      margin-bottom:15px;
    }
    .empty {
      text-align:center;
      color:#999;
      font-size:13px;
      padding:20px;
    }
    @media(max-width:500px) {
      .admin-nav-tabs {
        flex-direction:column;
      }
      .admin-bar {
        align-items:stretch;
      }
    }
  </style>
</head>
<body>
<div class="container">
  <!-- ADMIN BAR -->
  <div class="admin-bar" id="adminBar">
    <div class="admin-nav-tabs">
      <button class="nav-tab-btn active"
              id="tabHomeBtn"
              onclick="switchTab('user')">
        หน้าหลัก
      </button>
      <button class="nav-tab-btn"
              id="tabAdminBtn"
              onclick="switchTab('admin')">
        ⚙️ จัดการระบบ
      </button>
    </div>
    <button class="sm-btn btn-delete"
            onclick="logoutAdmin()">
      ออก
    </button>
  </div>
  <!-- HEADER -->
  <header class="company-header">
    <div class="logo-wrapper">
      <img src="https://i.postimg.cc/ZqwL8RKR/Untitled-design.png"
           alt="NP-404">
    </div>
    <h1>ระบบติดตามสถานะค่ากีฬาสี</h1>
    <p>NP-404</p>
  </header>
  <!-- SUMMARY -->
  <div class="summary-container">
    <div class="summary-card">
      <h4>👕 สรุปค่าเสื้อ</h4>
      <div class="summary-row">
        <span>จ่ายแล้ว:</span>
        <span class="text-success">
          <span id="shirtPaidCount">0</span> คน
          (<span id="shirtPaidAmount">0</span> บ.)
        </span>
      </div>
      <div class="summary-row">
        <span>ยังไม่จ่าย:</span>
        <span class="text-danger">
          <span id="shirtUnpaidCount">0</span> คน
          (<span id="shirtUnpaidAmount">0</span> บ.)
        </span>
      </div>
    </div>
    <div class="summary-card">
      <h4>🏆 สรุปค่าบำรุง</h4>
      <div class="summary-row">
        <span>จ่ายแล้ว:</span>
        <span class="text-success">
          <span id="feePaidCount">0</span> คน
          (<span id="feePaidAmount">0</span> บ.)
        </span>
      </div>
      <div class="summary-row">
        <span>ยังไม่จ่าย:</span>
        <span class="text-danger">
          <span id="feeUnpaidCount">0</span> คน
          (<span id="feeUnpaidAmount">0</span> บ.)
        </span>
      </div>
    </div>
  </div>
  <!-- MAIN -->
  <main class="main-card">
    <!-- USER -->
    <div id="userMainView">
      <div style="margin-bottom:12px">
        <input
          type="text"
          class="form-control"
          id="searchInput"
          placeholder="🔍 ค้นหาชื่อ หรือชั้นเรียน..."
          oninput="filterData()">
      </div>
      <div id="loading">
        กำลังโหลดข้อมูล...
      </div>
      <div id="studentList"></div>
    </div>
    <!-- ADMIN -->
    <div id="adminDashboardView">
      <div class="admin-form-section">
        <div class="admin-box-title" id="formTitle">
          ➕ เพิ่มข้อมูลนักเรียน
        </div>
        <input type="hidden" id="rowIndex">
        <div class="form-row">
          <div class="form-group">
            <label>คำนำหน้า</label>
            <input
              type="text"
              class="form-control"
              id="prefix"
              placeholder="นาย / นางสาว">
          </div>
          <div class="form-group">
            <label>ชื่อ-นามสกุล</label>
            <input
              type="text"
              class="form-control"
              id="name"
              placeholder="สมชาย ใจดี">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>เลขประจำตัว / เลขที่</label>
            <input
              type="text"
              class="form-control"
              id="studentId"
              placeholder="001">
          </div>
          <div class="form-group">
            <label>ชั้นเรียน / ห้อง</label>
            <input
              type="text"
              class="form-control"
              id="className"
              placeholder="ม.4/4">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>สถานะค่าเสื้อ</label>
            <select class="form-control" id="shirtStatus">
              <option value="ค้างชำระ">
                ค้างชำระ
              </option>
              <option value="ชำระแล้ว">
                ชำระแล้ว
              </option>
            </select>
          </div>
          <div class="form-group">
            <label>ค่าเสื้อ (บาท)</label>
            <input
              type="number"
              class="form-control"
              id="shirtAmount"
              value="250">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>สถานะค่าบำรุง</label>
            <select class="form-control" id="feeStatus">
              <option value="ค้างชำระ">
                ค้างชำระ
              </option>
              <option value="ชำระแล้ว">
                ชำระแล้ว
              </option>
            </select>
          </div>
          <div class="form-group">
            <label>ค่าบำรุง (บาท)</label>
            <input
              type="number"
              class="form-control"
              id="feeAmount"
              value="100">
          </div>
        </div>
        <div class="form-group">
          <label>หมายเหตุ</label>
          <input
            type="text"
            class="form-control"
            id="note"
            placeholder="-">
        </div>
        <div class="btn-container">
          <button
            class="action-btn"
            id="btnAdd"
            onclick="saveStudent()">
            + บันทึกข้อมูล
          </button>
          <button
            class="action-btn"
            id="btnUpdate"
            style="display:none"
            onclick="submitEdit()">
            บันทึกแก้ไข
          </button>
          <button
            class="action-btn btn-secondary"
            id="btnCancel"
            style="display:none"
            onclick="resetForm()">
            ยกเลิก
          </button>
        </div>
      </div>
      <div class="admin-box-title">
        📋 ตารางจัดการข้อมูลทั้งหมด
      </div>
      <div class="admin-table-container">
        <table class="admin-table">
          <thead>
            <tr>
              <th>ชื่อ-นามสกุล</th>
              <th>ห้อง</th>
              <th>ค่าเสื้อ</th>
              <th>ค่าบำรุง</th>
              <th>จัดการ</th>
            </tr>
          </thead>
          <tbody id="adminTableBody"></tbody>
        </table>
      </div>
    </div>
  </main>
  <footer class="footer">
    <div>
      © 2026 All Rights Reserved. by FLAME SHOP
    </div>
    <button
      class="admin-login-link"
      id="adminAccessBtn"
      onclick="openAdminModal()">
      🔒 จัดการระบบ (Admin)
    </button>
  </footer>
</div>
<!-- ADMIN LOGIN -->
<div class="modal-overlay" id="adminPasswordModal">
  <div class="modal-box">
    <h3>🔒 เข้าสู่โหมดแอดมิน</h3>
    <p>
      กรุณากรอกรหัสผ่านเพื่อเข้าใช้งาน
    </p>
    <input
      type="password"
      id="adminPassInput"
      class="form-control"
      style="margin-bottom:12px;text-align:center"
      placeholder="รหัสผ่าน"
      onkeydown="if(event.key==='Enter') submitAdminPassword()">
    <div class="btn-container">
      <button
        class="action-btn btn-secondary"
        onclick="closeModal('adminPasswordModal')">
        ยกเลิก
      </button>
      <button
        class="action-btn"
        onclick="submitAdminPassword()">
        ยืนยัน
      </button>
    </div>
  </div>
</div>
<!-- ALERT -->
<div class="modal-overlay" id="alertModal">
  <div class="modal-box">
    <div class="modal-icon" id="alertIcon">
      ⚠️
    </div>
    <h3 id="alertTitle">
      แจ้งเตือน
    </h3>
    <p id="alertMessage">
      เกิดข้อผิดพลาด
    </p>
    <button
      class="action-btn"
      onclick="closeModal('alertModal')">
      ตกลง
    </button>
  </div>
</div>
<!-- CONFIRM -->
<div class="modal-overlay" id="confirmModal">
  <div class="modal-box">
    <h3 id="confirmTitle">
      ยืนยันการทำรายการ
    </h3>
    <p id="confirmMessage">
      คุณแน่ใจหรือไม่?
    </p>
    <div class="btn-container">
      <button
        class="action-btn btn-secondary"
        onclick="closeModal('confirmModal')">
        ยกเลิก
      </button>
      <button
        class="action-btn btn-danger"
        id="confirmOkBtn">
        ตกลง
      </button>
    </div>
  </div>
</div>
<script>
  /* =====================================================
     SUPABASE CONFIG
     ===================================================== */
  const SUPABASE_URL =
    'https://itpgcbkypwjlawtshozr.supabase.co';
  /*
    ใส่ Publishable Key ของโปรเจกต์ itpgcbkypwjlawtshozr
    ตรงนี้
  */
  const SUPABASE_KEY =
    'ใส่-PUBLISHABLE-KEY-ของคุณตรงนี้';
  const supabaseClient =
    window.supabase.createClient(
      SUPABASE_URL,
      SUPABASE_KEY
    );
  /* =====================================================
     STATE
     ===================================================== */
  let isAdmin = false;
  let allStudents = [];
  let confirmCallback = null;
  /* =====================================================
     START
     ===================================================== */
  window.addEventListener('load', () => {
    loadData();
  });
  /* =====================================================
     MODAL
     ===================================================== */
  function openModal(id) {
    document.getElementById(id).style.display = 'flex';
  }
  function closeModal(id) {
    document.getElementById(id).style.display = 'none';
  }
  function showAlert(
    title,
    message,
    icon = '⚠️'
  ) {
    document.getElementById('alertIcon').innerText = icon;
    document.getElementById('alertTitle').innerText = title;
    document.getElementById('alertMessage').innerText = message;
    openModal('alertModal');
  }
  function showConfirm(
    title,
    message,
    callback
  ) {
    document.getElementById('confirmTitle').innerText =
      title;
    document.getElementById('confirmMessage').innerText =
      message;
    confirmCallback = callback;
    document.getElementById('confirmOkBtn').onclick =
      function() {
        closeModal('confirmModal');
        if (confirmCallback) {
          confirmCallback();
        }
      };
    openModal('confirmModal');
  }
  /* =====================================================
     ADMIN
     ===================================================== */
  function openAdminModal() {
    if (isAdmin) {
      switchTab('admin');
      return;
    }
    document.getElementById('adminPassInput').value = '';
    openModal('adminPasswordModal');
  }
  /*
    หมายเหตุ:
    ตอนนี้ใช้รหัส Admin ฝั่ง Client เพื่อให้หน้าเว็บ
    ทำงานได้ทันที
    สำหรับใช้งานจริงควรเปลี่ยนเป็น Supabase Auth
  */
  function submitAdminPassword() {
    const password =
      document.getElementById('adminPassInput').value;
    if (!password) {
      showAlert(
        'ข้อผิดพลาด',
        'กรุณากรอกรหัสผ่าน',
        '❌'
      );
      return;
    }
    /*
      เปลี่ยนรหัสตรงนี้
    */
    const ADMIN_PASSWORD = '123456';
    if (password !== ADMIN_PASSWORD) {
      showAlert(
        'รหัสผ่านไม่ถูกต้อง',
        'กรุณาตรวจสอบรหัสผ่านอีกครั้ง',
        '❌'
      );
      return;
    }
    closeModal('adminPasswordModal');
    isAdmin = true;
    applyAdminModeUI();
    switchTab('admin');
    showAlert(
      'สำเร็จ',
      'เข้าสู่ระบบแอดมินเรียบร้อยแล้ว',
      '✅'
    );
  }
  function logoutAdmin() {
    isAdmin = false;
    applyAdminModeUI();
    switchTab('user');
    showAlert(
      'ออกจากระบบ',
      'ออกจากโหมดแอดมินแล้ว',
      'ℹ️'
    );
  }
  function applyAdminModeUI() {
    document.getElementById('adminBar').style.display =
      isAdmin ? 'flex' : 'none';
    document.getElementById('adminAccessBtn').style.display =
      isAdmin ? 'none' : 'inline-block';
  }
  /* =====================================================
     TAB
     ===================================================== */
  function switchTab(tab) {
    const userView =
      document.getElementById('userMainView');
    const adminView =
      document.getElementById('adminDashboardView');
    const homeBtn =
      document.getElementById('tabHomeBtn');
    const adminBtn =
      document.getElementById('tabAdminBtn');
    if (tab === 'admin' && isAdmin) {
      userView.style.display = 'none';
      adminView.style.display = 'block';
      homeBtn.classList.remove('active');
      adminBtn.classList.add('active');
      renderAdminTable(allStudents);
    } else {
      userView.style.display = 'block';
      adminView.style.display = 'none';
      homeBtn.classList.add('active');
      adminBtn.classList.remove('active');
      renderData(allStudents);
    }
  }
  /* =====================================================
     LOAD DATA
     ===================================================== */
  async function loadData() {
    showLoading(true);
    const {
      data,
      error
    } = await supabaseClient
      .from('sports_students')
      .select('*')
      .order('student_id', {
        ascending:true
      });
    showLoading(false);
    if (error) {
      console.error(error);
      showAlert(
        'เชื่อมต่อฐานข้อมูลไม่สำเร็จ',
        error.message,
        '❌'
      );
      return;
    }
    allStudents = data || [];
    renderData(allStudents);
    renderAdminTable(allStudents);
    updateStats(allStudents);
  }
  /* =====================================================
     USER DISPLAY
     ===================================================== */
  function renderData(data) {
    const list =
      document.getElementById('studentList');
    list.innerHTML = '';
    if (!data.length) {
      list.innerHTML =
        '<div class="empty">ยังไม่มีข้อมูลในระบบ</div>';
      return;
    }
    data.forEach(item => {
      const card =
        document.createElement('div');
      card.className = 'student-card';
      const shirtClass =
        item.shirt_status === 'ชำระแล้ว'
          ? 'badge-success'
          : 'badge-danger';
      const feeClass =
        item.fee_status === 'ชำระแล้ว'
          ? 'badge-success'
          : 'badge-danger';
      card.innerHTML = `
        <div class="student-header">
          <span class="student-name">
            ${escapeHtml(item.prefix)}
            ${escapeHtml(item.name)}
          </span>
          <span class="student-class">
            ${escapeHtml(item.class_name)}
          </span>
        </div>
        <div class="status-group">
          <span>
            👕 ค่าเสื้อ
            (${formatMoney(item.shirt_amount)} บ.)
          </span>
          <span class="badge ${shirtClass}">
            ${escapeHtml(item.shirt_status)}
          </span>
        </div>
        <div class="status-group">
          <span>
            🏆 ค่าบำรุง
            (${formatMoney(item.fee_amount)} บ.)
          </span>
          <span class="badge ${feeClass}">
            ${escapeHtml(item.fee_status)}
          </span>
        </div>
        ${
          item.note
            ? `
              <div style="
                font-size:11px;
                color:#888;
                margin-top:5px;
              ">
                หมายเหตุ:
                ${escapeHtml(item.note)}
              </div>
            `
            : ''
        }
      `;
      list.appendChild(card);
    });
  }
  /* =====================================================
     ADMIN TABLE
     ===================================================== */
  function renderAdminTable(data) {
    const tbody =
      document.getElementById('adminTableBody');
    tbody.innerHTML = '';
    if (!data.length) {
      tbody.innerHTML = `
        <tr>
          <td colspan="5" style="text-align:center;color:#999">
            ไม่มีข้อมูล
          </td>
        </tr>
      `;
      return;
    }
    data.forEach(item => {
      const tr =
        document.createElement('tr');
      const shirtClass =
        item.shirt_status === 'ชำระแล้ว'
          ? 'badge-success'
          : 'badge-danger';
      const feeClass =
        item.fee_status === 'ชำระแล้ว'
          ? 'badge-success'
          : 'badge-danger';
      tr.innerHTML = `
        <td>
          ${escapeHtml(item.prefix)}
          ${escapeHtml(item.name)}
        </td>
        <td>
          ${escapeHtml(item.class_name)}
        </td>
        <td>
          <span class="badge ${shirtClass}">
            ${escapeHtml(item.shirt_status)}
          </span>
        </td>
        <td>
          <span class="badge ${feeClass}">
            ${escapeHtml(item.fee_status)}
          </span>
        </td>
        <td>
          <div style="
            display:flex;
            gap:4px;
          ">
            <button
              class="sm-btn btn-edit"
              onclick="startEdit('${item.id}')">
              แก้ไข
            </button>
            <button
              class="sm-btn btn-delete"
              onclick="deleteStudent('${item.id}')">
              ลบ
            </button>
          </div>
        </td>
      `;
      tbody.appendChild(tr);
    });
  }
  /* =====================================================
     SEARCH
     ===================================================== */
  function filterData() {
    const query =
      document.getElementById('searchInput')
        .value
        .trim()
        .toLowerCase();
    const filtered =
      allStudents.filter(item => {
        return (
          String(item.name || '')
            .toLowerCase()
            .includes(query)
          ||
          String(item.class_name || '')
            .toLowerCase()
            .includes(query)
          ||
          String(item.student_id || '')
            .toLowerCase()
            .includes(query)
        );
      });
    renderData(filtered);
  }
  /* =====================================================
     STATISTICS
     ===================================================== */
  function updateStats(data) {
    let shirtPaidCount = 0;
    let shirtPaidAmount = 0;
    let shirtUnpaidCount = 0;
    let shirtUnpaidAmount = 0;
    let feePaidCount = 0;
    let feePaidAmount = 0;
    let feeUnpaidCount = 0;
    let feeUnpaidAmount = 0;
    data.forEach(item => {
      const shirt =
        Number(item.shirt_amount) || 0;
      const fee =
        Number(item.fee_amount) || 0;
      if (item.shirt_status === 'ชำระแล้ว') {
        shirtPaidCount++;
        shirtPaidAmount += shirt;
      } else {
        shirtUnpaidCount++;
        shirtUnpaidAmount += shirt;
      }
      if (item.fee_status === 'ชำระแล้ว') {
        feePaidCount++;
        feePaidAmount += fee;
      } else {
        feeUnpaidCount++;
        feeUnpaidAmount += fee;
      }
    });
    document.getElementById('shirtPaidCount').innerText =
      shirtPaidCount;
    document.getElementById('shirtPaidAmount').innerText =
      shirtPaidAmount.toLocaleString();
    document.getElementById('shirtUnpaidCount').innerText =
      shirtUnpaidCount;
    document.getElementById('shirtUnpaidAmount').innerText =
      shirtUnpaidAmount.toLocaleString();
    document.getElementById('feePaidCount').innerText =
      feePaidCount;
    document.getElementById('feePaidAmount').innerText =
      feePaidAmount.toLocaleString();
    document.getElementById('feeUnpaidCount').innerText =
      feeUnpaidCount;
    document.getElementById('feeUnpaidAmount').innerText =
      feeUnpaidAmount.toLocaleString();
  }
  /* =====================================================
     ADD
     ===================================================== */
  async function saveStudent() {
    const name =
      document.getElementById('name').value.trim();
    if (!name) {
      showAlert(
        'ข้อผิดพลาด',
        'กรุณากรอกชื่อ-นามสกุล',
        '⚠️'
      );
      return;
    }
    const payload = {
      prefix:
        document.getElementById('prefix').value.trim(),
      name:name,
      student_id:
        document.getElementById('studentId').value.trim(),
      class_name:
        document.getElementById('className').value.trim(),
      shirt_status:
        document.getElementById('shirtStatus').value,
      shirt_amount:
        Number(
          document.getElementById('shirtAmount').value
        ) || 0,
      fee_status:
        document.getElementById('feeStatus').value,
      fee_amount:
        Number(
          document.getElementById('feeAmount').value
        ) || 0,
      note:
        document.getElementById('note').value.trim()
    };
    showLoading(true);
    const {
      error
    } = await supabaseClient
      .from('sports_students')
      .insert([payload]);
    showLoading(false);
    if (error) {
      console.error(error);
      showAlert(
        'บันทึกไม่สำเร็จ',
        error.message,
        '❌'
      );
      return;
    }
    resetForm();
    await loadData();
    showAlert(
      'สำเร็จ',
      'เพิ่มข้อมูลนักเรียนเรียบร้อยแล้ว',
      '✅'
    );
  }
  /* =====================================================
     EDIT
     ===================================================== */
  function startEdit(id) {
    const student =
      allStudents.find(item => item.id === id);
    if (!student) {
      showAlert(
        'ไม่พบข้อมูล',
        'ไม่พบข้อมูลนักเรียนที่ต้องการแก้ไข',
        '❌'
      );
      return;
    }
    document.getElementById('rowIndex').value =
      student.id;
    document.getElementById('prefix').value =
      student.prefix || '';
    document.getElementById('name').value =
      student.name || '';
    document.getElementById('studentId').value =
      student.student_id || '';
    document.getElementById('className').value =
      student.class_name || '';
    document.getElementById('shirtStatus').value =
      student.shirt_status || 'ค้างชำระ';
    document.getElementById('shirtAmount').value =
      student.shirt_amount ?? 250;
    document.getElementById('feeStatus').value =
      student.fee_status || 'ค้างชำระ';
    document.getElementById('feeAmount').value =
      student.fee_amount ?? 100;
    document.getElementById('note').value =
      student.note || '';
    document.getElementById('formTitle').innerText =
      '✏️ แก้ไขข้อมูลนักเรียน';
    document.getElementById('btnAdd').style.display =
      'none';
    document.getElementById('btnUpdate').style.display =
      'inline-flex';
    document.getElementById('btnCancel').style.display =
      'inline-flex';
    switchTab('admin');
    window.scrollTo({
      top:0,
      behavior:'smooth'
    });
  }
  async function submitEdit() {
    const id =
      document.getElementById('rowIndex').value;
    if (!id) return;
    const payload = {
      prefix:
        document.getElementById('prefix').value.trim(),
      name:
        document.getElementById('name').value.trim(),
      student_id:
        document.getElementById('studentId').value.trim(),
      class_name:
        document.getElementById('className').value.trim(),
      shirt_status:
        document.getElementById('shirtStatus').value,
      shirt_amount:
        Number(
          document.getElementById('shirtAmount').value
        ) || 0,
      fee_status:
        document.getElementById('feeStatus').value,
      fee_amount:
        Number(
          document.getElementById('feeAmount').value
        ) || 0,
      note:
        document.getElementById('note').value.trim()
    };
    if (!payload.name) {
      showAlert(
        'ข้อผิดพลาด',
        'กรุณากรอกชื่อ-นามสกุล',
        '⚠️'
      );
      return;
    }
    showLoading(true);
    const {
      error
    } = await supabaseClient
      .from('sports_students')
      .update(payload)
      .eq('id', id);
    showLoading(false);
    if (error) {
      console.error(error);
      showAlert(
        'แก้ไขไม่สำเร็จ',
        error.message,
        '❌'
      );
      return;
    }
    resetForm();
    await loadData();
    showAlert(
      'สำเร็จ',
      'แก้ไขข้อมูลเรียบร้อยแล้ว',
      '✅'
    );
  }
  /* =====================================================
     DELETE
     ===================================================== */
  function deleteStudent(id) {
    showConfirm(
      'ยืนยันการลบ',
      'คุณต้องการลบรายชื่อนี้ออกจากระบบใช่หรือไม่?',
      async function() {
        showLoading(true);
        const {
          error
        } = await supabaseClient
          .from('sports_students')
          .delete()
          .eq('id', id);
        showLoading(false);
        if (error) {
          console.error(error);
          showAlert(
            'ลบไม่สำเร็จ',
            error.message,
            '❌'
          );
          return;
        }
        await loadData();
        showAlert(
          'สำเร็จ',
          'ลบข้อมูลเรียบร้อยแล้ว',
          '✅'
        );
      }
    );
  }
  /* =====================================================
     RESET FORM
     ===================================================== */
  function resetForm() {
    document.getElementById('rowIndex').value =
      '';
    document.getElementById('studentId').value =
      '';
    document.getElementById('prefix').value =
      '';
    document.getElementById('name').value =
      '';
    document.getElementById('className').value =
      '';
    document.getElementById('shirtStatus').value =
      'ค้างชำระ';
    document.getElementById('shirtAmount').value =
      '250';
    document.getElementById('feeStatus').value =
      'ค้างชำระ';
    document.getElementById('feeAmount').value =
      '100';
    document.getElementById('note').value =
      '';
    document.getElementById('formTitle').innerText =
      '➕ เพิ่มข้อมูลนักเรียน';
    document.getElementById('btnAdd').style.display =
      'inline-flex';
    document.getElementById('btnUpdate').style.display =
      'none';
    document.getElementById('btnCancel').style.display =
      'none';
  }
  /* =====================================================
     LOADING
     ===================================================== */
  function showLoading(show) {
    document.getElementById('loading').style.display =
      show ? 'block' : 'none';
  }
  /* =====================================================
     HELPERS
     ===================================================== */
  function formatMoney(value) {
    return Number(value || 0)
      .toLocaleString('th-TH');
  }
  function escapeHtml(value) {
    if (value === null || value === undefined) {
      return '';
    }
    return String(value)
      .replace(/&/g,'&amp;')
      .replace(/</g,'&lt;')
      .replace(/>/g,'&gt;')
      .replace(/"/g,'&quot;')
      .replace(/'/g,'&#039;');
  }
</script>
</body>
